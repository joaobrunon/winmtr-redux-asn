    LTEXT           "www.appnor.com",IDC_STATIC,187,9,60,11
    LTEXT           "WinMTR (Redux) v1.00 se ofrece bajo GPLv2",IDC_STATIC,7,9,176,10
    LTEXT           "Uso: WinMTR [opciones] nombre_del_host",IDC_STATIC,7,29,144,8
    LTEXT           "Opciones:",IDC_STATIC,7,39,28,8
    LTEXT           "     --interval, -i VALUE. Establecer intervalo de ping.",IDC_STATIC,26,47,131,8
